
import turtle
import random

# Set up 
screen = turtle.Screen()
screen.setup(1000, 700)
screen.bgcolor("#101727")
screen.title("A Deadlock")
screen.tracer(0)

t = turtle.Turtle()
t.hideturtle()
t.speed(0)

random.seed(10)


# Draw a rectangle
def rectangle(x, y, width, height, color):
    t.penup()
    t.goto(x, y)
    t.setheading(0)
    t.color(color)
    t.pendown()
    t.begin_fill()

    for i in range(2):
        t.forward(width)
        t.left(90)
        t.forward(height)
        t.left(90)

    t.end_fill()
    t.penup()


# Draw a line
def line(x1, y1, x2, y2, color, size):
    t.penup()
    t.goto(x1, y1)
    t.setheading(0)
    t.pensize(size)
    t.color(color)
    t.pendown()
    t.goto(x2, y2)
    t.penup()
    t.pensize(1)


# Draw windows inside a building
def windows(x, y, width, height, step_x, step_y):
    for wx in range(x + 12, x + width - 18, step_x):
        for wy in range(y + 12, y + height - 18, step_y):
            if random.randint(1, 5) != 1:
                if random.randint(1, 2) == 1:
                    color = "#e8b85c"
                else:
                    color = "#8c9aab"

                rectangle(wx, wy, 8, 14, color)


# Draw a rooftop
def rooftop(x, y, width):
    rectangle(x, y, width, 8, "#394556")
    line(x + 8, y + 8, x + width - 8, y + 8,
         "#687486", 2)


